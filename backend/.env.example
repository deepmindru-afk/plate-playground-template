# Server-side OpenAI API key. When unset, the client-supplied apiKey in the
# request body is used as a fallback (disable with ALLOW_CLIENT_API_KEY=false).
OPENAI_API_KEY=

# Optional base URL for any OpenAI-compatible endpoint (e.g. OpenRouter,
# Gemini OpenAI-compat, Ollama, local vLLM).
# OPENAI_BASE_URL=

# Default models per AI feature. The client can override each request with
# `model` (provider prefix, e.g. "openai/gpt-4o-mini", is stripped).
AI_COMMAND_MODEL=gpt-4o-mini
AI_CHOOSE_MODEL=gpt-4o-mini
AI_EDIT_MODEL=gpt-4o-mini
AI_EDIT_SELECTION_MODEL=gpt-4o-mini
AI_COPILOT_MODEL=gpt-4o-mini

# Allow the client-supplied apiKey as a fallback when OPENAI_API_KEY is unset.
ALLOW_CLIENT_API_KEY=true

# Where documents are stored (default: backend/data/docs).
# PLATE_DATA_DIR=/path/to/data

# Origins allowed to call the backend (comma-separated).
# BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000